# Copy to .env and fill in. Do NOT commit the real .env.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
# Mapbox public token (restrict it to your domains in the Mapbox dashboard).
VITE_MAPBOX_TOKEN="pk.your-mapbox-token"
# Google Analytics 4 measurement id (G-XXXXXXX). Leave empty to disable analytics;
# the Google Ads tag in index.html works regardless.
VITE_GA4_ID=""
